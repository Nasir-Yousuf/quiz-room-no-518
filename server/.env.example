# Server Port
PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/quiz_room_db
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/quiz_room_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/quiz_room_db

# JWT Secret for Signing Authentication Tokens
JWT_SECRET=dev_jwt_secret_quiz_room_518_education_platform_secure_token

# Environment
NODE_ENV=development

# Allowed Frontend Origin for CORS
CLIENT_ORIGIN=http://localhost:5173
